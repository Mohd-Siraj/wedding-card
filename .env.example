# Copy to .env.local and fill in.
# Local: run `npm run db:start` and copy the values it prints.
# Hosted: Supabase dashboard > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Our App
